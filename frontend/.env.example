# API base URL for production environments (Android, iOS, PWA on a device).
# When running `npm run dev` locally, leave this unset so the Vite proxy handles
# requests to /api and /uploads automatically.
# For production, set this to your hosted backend URL, e.g.:
# VITE_API_URL=https://your-backend.example.com
VITE_API_URL=http://localhost:3001

# Firebase configuration
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/ → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
